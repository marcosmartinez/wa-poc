# Copiá este archivo a .env solo para pruebas locales. En Railway, cargá estas variables en el servicio.

# Obligatoria: contraseña del panel (usuario por defecto: admin)
ADMIN_PASSWORD=cambiame
ADMIN_USER=admin

# Opcional: habilita POST /api/send desde otros sistemas con el header x-api-key
API_KEY=

# Opcional: URL que recibe un POST por cada mensaje entrante
WEBHOOK_URL=
WEBHOOK_SECRET=

# Opcional: respuesta automática a cualquier mensaje directo (vacío = desactivado)
AUTO_REPLY_TEXT=

# Opcional: nombre que usa el bot en /ayuda
BOT_NAME=Bot

# Opcional: carpeta de datos. En Railway se usa automáticamente el volume montado.
# DATA_DIR=./data
