# Copiá este archivo a .env solo para pruebas locales. En Railway, cargá estas variables en el servicio.

# Obligatoria: contraseña del panel (usuario por defecto: admin)
ADMIN_PASSWORD=cambiame
ADMIN_USER=admin

# Habilita POST /api/send desde tu sistema con el header x-api-key
API_KEY=

# URL de tu sistema (el que tiene la lógica): recibe un POST por cada mensaje entrante
WEBHOOK_URL=
# Recomendada: clave para firmar cada webhook (header x-webhook-signature). Generala con: openssl rand -hex 32
WEBHOOK_SECRET=

# Opcional: nombre con el que se muestran los mensajes salientes en el panel
BOT_NAME=Bot

# Opcional: carpeta de datos. En Railway se usa automáticamente el volume montado.
# DATA_DIR=./data
